# World Labs Platform API key (https://platform.worldlabs.ai).
# API credits are separate from Marble app credits.
# Leave unset to run in mock mode: upload, progress, viewer, and download
# all work against a built-in courtyard splat and no credits are spent.
WORLDLABS_API_KEY=

# Optional. Object meshes (Hunyuan 3D) and sound (ElevenLabs SFX via FAL),
# plus Nano Banana image edits, stay off unless this is set.
# https://fal.ai/
FAL_KEY=

# Set to 1 to force mock mode even when WORLDLABS_API_KEY is present.
IMAGE_BLASTER_MOCK=
